#!/usr/bin/env python3
import sys
from pathlib import Path

# The shell watches the plugin directory; runtime bytecode writes would cause
# unnecessary plugin reloads as the status helper starts.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))
from theme_styles import main

if __name__ == "__main__":
    main()
